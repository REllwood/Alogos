{
  "name": "alogos",
  "version": "1.0.0",
  "description": "A lightweight library for detecting synthetic images using luminance-gradient PCA analysis",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENCE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && rollup -c",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run test:package",
    "lint": "eslint src scripts --ext .ts,.mjs",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "image-detection",
    "synthetic-image",
    "deepfake-detection",
    "gradient-analysis",
    "pca",
    "ai-detection",
    "diffusion-model",
    "image-authenticity"
  ],
  "author": "Rhys Ellwood",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/REllwood/alogos.git"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "rollup": "^4.9.4",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
